generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// Better Auth tables
model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions session[]
  accounts account[]

  @@map("user")
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model account {
  id                String   @id
  accountId         String
  providerId        String
  userId            String
  accessToken       String?
  refreshToken      String?
  idToken           String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  password          String?
  createdAt         DateTime
  updatedAt         DateTime

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// PATULOD Admin table (separate from Better Auth user table)
model Admin {
  id          String    @id @default(cuid())
  fullName    String
  email       String    @unique
  phone       String?
  userId      String    @unique  // Links to Better Auth user.id
  isActive    Boolean   @default(true)
  role        String    @default("STAFF") // STAFF, MANAGER, SUPER_ADMIN
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("admins")
}

// PATULOD User table (Passengers and Drivers) - linked to Better Auth user table
model PatulodUser {
  id                      String    @id @default(cuid())
  fullName                String
  phone                   String    @unique
  userId                  String    @unique  // Links to Better Auth user.id
  role                    String    // PASSENGER or DRIVER (assigned server-side only)
  isActive                Boolean   @default(true)
  isSuspended             Boolean   @default(false)
  suspendedReason         String?
  termsAcceptedAt         DateTime?
  privacyAcknowledgedAt   DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  termsAcceptances        TermsAcceptance[]
  privacyAcknowledgments  PrivacyAcknowledgment[]
  auditLogs               AuditLog[]

  @@map("patulod_users")
}

// Terms Acceptance tracking
model TermsAcceptance {
  id            String        @id @default(cuid())
  userId        String
  termsVersion  String        // e.g., "1.0", "2.0"
  acceptedAt    DateTime      @default(now())

  user          PatulodUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("terms_acceptances")
}

// Privacy Notice Acknowledgment tracking
model PrivacyAcknowledgment {
  id              String        @id @default(cuid())
  userId          String
  noticeVersion   String        // e.g., "1.0", "2.0"
  acknowledgedAt  DateTime      @default(now())

  user            PatulodUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_acknowledgments")
}

// Audit Log for user actions
model AuditLog {
  id          String        @id @default(cuid())
  userId      String?
  entity      String        // e.g., "User", "Booking", "Trip"
  action      String        // e.g., "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  actorId     String?       // ID of the user who performed the action
  actorRole   String?       // PASSENGER, DRIVER, or ADMIN
  metadata    Json?         // Additional context (never includes plaintext passwords)
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime      @default(now())

  user        PatulodUser?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Policy Content (Terms, Privacy Notice, Safety Guidelines)
model PolicyContent {
  id              String    @id @default(cuid())
  type            String    // TERMS, PRIVACY, SAFETY
  version         String    // e.g., "1.0", "2.0"
  content         String    @db.Text
  effectiveDate   DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([type, version])
  @@map("policy_contents")
}

// Driver Application (Phase 5)
model DriverApplication {
  id                String    @id @default(cuid())
  fullName          String
  email             String
  phone             String
  vehicleType       String    // motorcycle, tricycle
  plateNumber       String
  vehicleModel      String
  vehicleColor      String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, DOCUMENTS_NEEDED
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?   // Admin ID who reviewed
  rejectionReason   String?
  notes             String?   // Admin notes
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  documents         DriverDocument[]

  @@map("driver_applications")
}

// Driver Document Upload (Phase 5)
model DriverDocument {
  id                  String    @id @default(cuid())
  driverApplicationId String
  documentType        String    // DRIVERS_LICENSE_FRONT, DRIVERS_LICENSE_BACK, VEHICLE_OR_CR, GOVERNMENT_ID, VEHICLE_PHOTO_FRONT, VEHICLE_PHOTO_SIDE, VEHICLE_PHOTO_PLATE
  fileData            String    @db.Text // Base64 encoded file data
  fileName            String    // Original filename
  mimeType            String    // image/jpeg, image/png, application/pdf
  fileSize            Int       // File size in bytes
  uploadedAt          DateTime  @default(now())
  reviewStatus        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  application         DriverApplication @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)

  @@map("driver_documents")
}